# Gemini API (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Host login
HOST_USERNAME=host
HOST_PASSWORD=change_me

PORT=3000

# Optional tuning
# EVENT_MINUTES=45
# RELEASE_SECONDS=60
# MOCK_AI=1   (fake AI output for testing without a key)

# Event settings (defaults shown)
# PARTICIPANT_COUNT=70     accounts pa001..pa070 are created on first start
# PROMPT_MIN=1             minimum non-empty prompt length
# PROMPT_MAX=2000          maximum prompt length
# QUIZ_SECONDS=60          time limit per quiz attempt (2 attempts per round)
# QUIZ_PASS=3              correct answers needed (out of QUIZ_QUESTIONS) to unlock the reward prompt
# QUIZ_QUESTIONS=5         questions per attempt
